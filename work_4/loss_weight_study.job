#!/bin/bash

#PBS -N loss_weight_study
#PBS -o loss_weight_study.out
#PBS -e loss_weight_study.err
#PBS -l walltime=12:30:00
#PBS -l select=1:ncpus=1:mpiprocs=1:ngpus=1:host=compute-1-1

set -eo pipefail

cd "$PBS_O_WORKDIR"

cat "${PBS_NODEFILE:?PBS node file is unavailable.}"

# Ensure the study uses the activated environment's interpreter.
export PYTHON_BIN="/home/thiago.esterci/.conda/envs/torch-numba-11/bin/python"

pwd

time GENERATIONS=400 BUDGET=29000 RUNS=10 POPULATION_SIZE=32 bash shells/run_loss_weight_study.sh   --hidden-sizes 64 64 64 64 64   --activation-functions Tanh ReLu Tanh ReLu Tanh   --adaptation-probability 0.1 --initial-loss-weights 10 10 10 "
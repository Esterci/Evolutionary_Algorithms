{
    "equations": [
        "u_t + (u^2/2)_x + (u*v)_y = nu*Laplacian(u)",
        "v_t + (u*v)_x + (v^2/2)_y = nu*Laplacian(v)"
    ],
    "numerical_flux": "first-order donor-cell upwind",
    "time_integrator": "forward Euler",
    "initial_condition": {
        "u": "mean_velocity_u + perturbation_amplitude*sin(phase_x)*cos(phase_y)",
        "v": "mean_velocity_v - perturbation_amplitude*cos(phase_x)*sin(phase_y)"
    },
    "mesh": {
        "h": 0.05,
        "k": 0.005,
        "x_dom": [
            0,
            1
        ],
        "y_dom": [
            0,
            1
        ],
        "t_dom": [
            0,
            1
        ]
    },
    "constants": {
        "nu": 0.01,
        "boundary": "zero_gradient",
        "mean_velocity_u": 0.5,
        "mean_velocity_v": 0.25,
        "perturbation_amplitude": 1.0
    },
    "array_shape": [
        201,
        20,
        20
    ]
}
